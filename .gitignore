# The virtual environment is never committed: it is machine-specific
# (absolute paths inside) and weighs ~500 MB. requirements.txt is enough to recreate it.
.venv/

# Compiled Python files, auto-generated
__pycache__/
*.pyc

# Raw EDF files downloaded from PhysioNet (~50 MB/subject).
# We don't commit downloadable public data: the code fetches it on its own.
data/

# macOS clutter file
.DS_Store

# R session history, unrelated to this Python project
.Rhistory
